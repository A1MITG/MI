# Copy this file to .env (in this MI folder) and fill in your keys. .env is never committed.

# Required for live studies. Without it the app shows sample data.
OPENAI_API_KEY=
# Model that writes the study (default gpt-4o-mini). A stronger model gives more imaginative foresight.
# OPENAI_MODEL=gpt-4.1

# Web search: tavily | openai | none
#   tavily - Tavily searches the web; the model cites the numbered sources (needs TAVILY_API_KEY)
#   openai - OpenAI searches the web itself (uses OPENAI_API_KEY, model below)
#   none   - no search; answers from the model's memory only
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# OPENAI_SEARCH_MODEL=gpt-4.1-mini

# Where each run is saved as an HTML file (default: the runs folder here)
# RUNS_DIR=

# PORT=4000
